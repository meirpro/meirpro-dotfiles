{
  "name": "Force DNS (SafeSearch)",
  "description": "Every DNS query must go through Cloudflare (WARP / Gateway). Plain DNS is allowed only for the system resolver (mDNSResponder), which every app uses and which must reach a captive portal's DNS while WARP is paused; every other process is denied raw DNS, DNS-over-TLS, and the well-known DNS-over-HTTPS resolvers, so a browser cannot route around the SafeSearch-enforcing resolver. Specific allow rules beat the deny-any rules. Import: `open force-dns.lsrules`, then mark the group Protected in Little Snitch > Rules.",
  "rules": [
    {
      "action": "allow",
      "process": "/usr/sbin/mDNSResponder",
      "direction": "outgoing",
      "remote": "any",
      "ports": "53",
      "notes": "System resolver. Needed for captive portals while WARP is paused; when WARP is up it talks to WARP's local stub."
    },
    {
      "action": "allow",
      "process": "any",
      "direction": "outgoing",
      "remote-addresses": "1.1.1.1,1.0.0.1,1.1.1.2,1.0.0.2,1.1.1.3,1.0.0.3,2606:4700:4700::1111,2606:4700:4700::1001,2606:4700:4700::1112,2606:4700:4700::1002,2606:4700:4700::1113,2606:4700:4700::1003",
      "ports": "53,853",
      "notes": "Cloudflare resolvers, plain and DoT"
    },
    {
      "action": "allow",
      "process": "any",
      "direction": "outgoing",
      "remote-domains": "cloudflare-dns.com,cloudflare-gateway.com,cloudflareclient.com",
      "ports": "443,853,2408",
      "notes": "Cloudflare DoH/DoT + WARP tunnel (853 so Gateway DoT can be tested from the Mac)"
    },
    {
      "action": "deny",
      "process": "any",
      "direction": "outgoing",
      "remote": "any",
      "ports": "53",
      "notes": "Any other process doing its own raw DNS (UDP and TCP)"
    },
    {
      "action": "deny",
      "process": "any",
      "direction": "outgoing",
      "remote": "any",
      "protocol": "tcp",
      "ports": "853",
      "notes": "DNS over TLS"
    },
    {
      "action": "deny",
      "process": "any",
      "direction": "outgoing",
      "remote-domains": "dns.google,dns.google.com,dns.quad9.net,doh.opendns.com,mozilla.cloudflare-dns.com,dns.adguard.com,dns.adguard-dns.com,dns.nextdns.io,doh.cleanbrowsing.org,dns.controld.com,doh.dns.sb,dns.alidns.com,doh.360.cn",
      "ports": "443",
      "notes": "DNS-over-HTTPS resolvers browsers ship with"
    },
    {
      "action": "deny",
      "process": "any",
      "direction": "outgoing",
      "remote-addresses": "8.8.8.8,8.8.4.4,9.9.9.9,149.112.112.112,208.67.222.222,208.67.220.220,94.140.14.14,94.140.15.15,2001:4860:4860::8888,2001:4860:4860::8844,2620:fe::fe,2620:fe::9",
      "ports": "443",
      "notes": "Same resolvers by IP"
    }
  ]
}