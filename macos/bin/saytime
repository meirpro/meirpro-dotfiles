#!/usr/bin/env bash
#
# Speak the current time as a 15-minute passage-of-time reminder.
#
# This is a stopgap. The real version is a menu bar app with a settings GUI,
# a mic/camera guard, and independent volume — see the `quarter` project.
# Kept because it is dependency-free and survives any rewrite.
#
# Not AM/PM: the point is noticing that 15 minutes went by, and which half of
# the day it is was never in doubt. macOS's built-in announcement is otherwise
# equivalent (Menu bar → Clock Options → Announce the time); it is disabled on
# this machine so the two don't both fire.
#
# Usage:  saytime            # speaks "It's 2:15"
#         saytime --print    # print instead of speak (testing / cron debug)
#
# Config, via environment (cron sets none of these; edit the crontab to):
#   SAYTIME_VOLUME   0.0–1.0, default 0.35. Relative to system output volume.
#   SAYTIME_VOICE    a voice name from `say -v ?`, default = system voice.
#   SAYTIME_RATE     words per minute, default = voice's own rate.
#
# Driven by cron every 15 minutes — see macos/cron/README.md.

set -uo pipefail

VOLUME="${SAYTIME_VOLUME:-0.35}"
VOICE="${SAYTIME_VOICE:-}"
RATE="${SAYTIME_RATE:-}"

# %-I strips the leading zero (2, not 02) and gives 12-hour regardless of the
# 24-hour menu bar clock. On the hour, say "2 o'clock" rather than "2:00",
# which some voices read as "two colon zero zero".
if [[ $(date '+%M') == "00" ]]; then
    phrase="It's $(date '+%-I') o'clock"
else
    phrase="It's $(date '+%-I:%M')"
fi

if [[ ${1:-} == "--print" ]]; then
    echo "$phrase"
    exit 0
fi

# `say` has no --volume flag. Volume is set with an inline speech command,
# [[volm N]], which the synthesiser consumes rather than reads aloud. It
# attenuates relative to system output volume — it cannot exceed it.
# --- TEMPORARY INSTRUMENTATION (2026-08-20) ---------------------------------
# Investigating: after the Mac wakes, several announcements fire at once with a
# non-quarter-hour time. Records every invocation so the next occurrence is
# evidence rather than recollection. Remove once the cause is confirmed.
printf '%s pid=%s ppid=%s phrase=%s\n' "$(date '+%F %T')" "$$" "$PPID" "$phrase" \
    >> "$HOME/Library/Logs/saytime.log"
# ---------------------------------------------------------------------------

args=()
[[ -n $VOICE ]] && args+=(-v "$VOICE")
[[ -n $RATE  ]] && args+=(-r "$RATE")

# ${args[@]+"${args[@]}"} not "${args[@]}": macOS ships bash 3.2, where an
# empty array expansion counts as unset and trips `set -u`. Bash 4.4+ fixed it.
exec /usr/bin/say ${args[@]+"${args[@]}"} "[[volm ${VOLUME}]] ${phrase}"
