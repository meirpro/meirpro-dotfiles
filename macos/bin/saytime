#!/usr/bin/env bash
#
# Speak the current time as a 15-minute passage-of-time reminder.
#
# This is a stopgap. The real version is a menu bar app with a settings GUI,
# a mic/camera guard, and independent volume — see the `belfry` project.
# Kept because it is dependency-free and survives any rewrite.
#
# Not AM/PM: the point is noticing that 15 minutes went by, and which half of
# the day it is was never in doubt. macOS's built-in announcement is otherwise
# equivalent (Menu bar → Clock Options → Announce the time); it is disabled on
# this machine so the two don't both fire.
#
# Usage:  saytime            # speaks "It's 2:15"
#         saytime --print    # print instead of speak (testing / cron debug)
#         saytime --force    # speak even if past the staleness window
#
# Config, via environment (set in the crontab):
#   SAYTIME_VOLUME   0.0–1.0, default 0.35. Relative to system output volume.
#   SAYTIME_VOICE    a voice name from `say -v ?`, default = system voice.
#   SAYTIME_RATE     words per minute, default = voice's own rate.
#   SAYTIME_MAX_LAG  seconds past the quarter mark before an announcement is
#                    dropped as stale. Default 90. See "Staleness" below.
#   SAYTIME_TIMEOUT  seconds before a blocked `say` is killed, and before a
#                    held lock is considered stuck. Default 30.
#
# Driven by cron every 15 minutes — see macos/cron/README.md.

set -uo pipefail

VOLUME="${SAYTIME_VOLUME:-0.35}"
VOICE="${SAYTIME_VOICE:-}"
RATE="${SAYTIME_RATE:-}"
MAX_LAG="${SAYTIME_MAX_LAG:-90}"
TIMEOUT="${SAYTIME_TIMEOUT:-30}"
LOG="$HOME/Library/Logs/saytime.log"

log() { printf '%s pid=%-6s %s\n' "$(date '+%F %T')" "$$" "$1" >> "$LOG"; }

# %-I strips the leading zero (2, not 02) and gives 12-hour regardless of the
# 24-hour menu bar clock. On the hour, say "2 o'clock" rather than "2:00",
# which some voices read as "two colon zero zero".
if [[ $(date '+%M') == "00" ]]; then
    phrase="It's $(date '+%-I') o'clock"
else
    phrase="It's $(date '+%-I:%M')"
fi

if [[ ${1:-} == "--print" ]]; then
    echo "$phrase"
    exit 0
fi

# --- Staleness -------------------------------------------------------------
# cron REPLAYS jobs missed while the machine was asleep, as long as the gap is
# under 600 seconds. It advances its internal clock minute by minute and runs
# each missed minute's jobs on wake. `date` inside this script then returns the
# *wake* time, not the boundary — so a 5:00 job replayed at 5:03 announced
# "It's 5:03", which is both late and wrong.
#
# Measured over 132 logged invocations on this machine: 59 of them (45%) fired
# late, with a maximum lag of 571s — just under cron's 600s cutoff, which is
# what identified the mechanism. `sleep 1` on battery makes short naps constant
# here, so quarter marks are missed and replayed all day.
#
# Fix: drop the announcement if we are more than MAX_LAG seconds past the mark.
# Computed from local minute/second rather than `epoch % 900`, because that
# arithmetic only holds in timezones whose UTC offset is a whole hour.
lag=$(( (10#$(date '+%M') % 15) * 60 + 10#$(date '+%S') ))

if [[ ${1:-} != "--force" ]] && (( lag > MAX_LAG )); then
    log "SKIP  stale by ${lag}s (max ${MAX_LAG}s) — would have said \"$phrase\""
    exit 0
fi

# --- Overlap guard, with stale-lock recovery -------------------------------
# `say` BLOCKS INDEFINITELY when the audio output device is suspended by system
# sleep. It does not fail and does not give up — it sits there and finally
# plays on wake. Measured here: two runs returned after 15137s (4h12m) and
# 8125s (2h15m), against a 2s baseline with the device awake. That is the
# overlapping-announcements bug: several utterances queue up across a sleep and
# flush together when the lid opens.
#
# A plain lock made this worse, not better. One stuck `say` held it for four
# hours and silently suppressed 13 announcements — a rare fault (2 of 21 runs)
# turned into an outage, which is a worse failure than the one it fixed.
#
# So the lock must be takeable: steal it if the holder is dead, or has held it
# longer than any legitimate announcement could take. `set -o noclobber` is the
# atomic create-if-absent — flock(1) does not exist on macOS.
LOCK="${TMPDIR:-/tmp}/saytime.lock"

take_lock() { (set -o noclobber; echo $$ > "$LOCK") 2>/dev/null; }

if ! take_lock; then
    holder=$(cat "$LOCK" 2>/dev/null)
    held=$(( $(date +%s) - $(stat -f %m "$LOCK" 2>/dev/null || echo 0) ))

    if [[ -z $holder ]] || ! kill -0 "$holder" 2>/dev/null; then
        log "LOCK  holder ${holder:-?} is gone — reclaiming"
        rm -f "$LOCK"
    elif (( held > TIMEOUT )); then
        log "LOCK  holder $holder stuck for ${held}s — killing it and reclaiming"
        kill -9 "$holder" 2>/dev/null
        rm -f "$LOCK"
    else
        log "SKIP  pid $holder still speaking (${held}s) — would have said \"$phrase\""
        exit 0
    fi

    take_lock || { log "SKIP  could not take lock — would have said \"$phrase\""; exit 0; }
fi
trap 'rm -f "$LOCK"' EXIT INT TERM

args=()
[[ -n $VOICE ]] && args+=(-v "$VOICE")
[[ -n $RATE  ]] && args+=(-r "$RATE")

# --- Speak, under a watchdog -----------------------------------------------
# `say` is run in the background and killed if it outlives TIMEOUT, so a
# suspended audio device can never leave one parked for hours. An announcement
# takes 2s awake; anything past 30s is stuck, and a stuck one has nothing
# useful left to say — by the time the device wakes, its time is long wrong.
#
# The watchdog measures WALL CLOCK, not elapsed sleep: this loop is suspended
# along with everything else during system sleep, so the deadline is only
# noticed on wake. That is exactly when it needs to fire, and it bounds the
# late audio to roughly one second rather than a full announcement.
#
# Not `exec say`: exec would replace this shell, so neither the watchdog, the
# timing, nor the lock cleanup would ever run.
started=$(date +%s)
log "SPEAK lag=${lag}s \"$phrase\""

# ${args[@]+"${args[@]}"} not "${args[@]}": macOS ships bash 3.2, where an
# empty array expansion counts as unset and trips `set -u`.
/usr/bin/say ${args[@]+"${args[@]}"} "[[volm ${VOLUME}]] ${phrase}" &
say_pid=$!

killed=0
deadline=$(( started + TIMEOUT ))
while kill -0 "$say_pid" 2>/dev/null; do
    if (( $(date +%s) >= deadline )); then
        kill -9 "$say_pid" 2>/dev/null
        killed=1
        break
    fi
    sleep 1
done

wait "$say_pid" 2>/dev/null
rc=$?
elapsed=$(( $(date +%s) - started ))

if (( killed )); then
    log "KILL  ran ${elapsed}s > ${TIMEOUT}s limit — dropped \"$phrase\" (usually a suspended audio device)"
    exit 0
fi

log "DONE  rc=${rc} after ${elapsed}s"
exit $rc
