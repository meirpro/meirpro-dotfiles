#!/usr/bin/env bash
#
# Speak the current time in 12-hour am/pm, regardless of the menu bar clock.
#
# macOS has a built-in "Announce the time" (System Settings → Menu bar → Clock
# Options) with the same quarter-hour intervals and the same voice controls.
# The one thing it will not do is say AM or PM — its string is always
# "It's two o'clock". AM/PM is a *display* setting for the menu bar clock only.
# This machine runs a 24-hour menu bar, so the built-in announcement is
# ambiguous and switching the clock format to fix it isn't wanted.
#
# Usage:  saytime            # "It's 2:15 PM"
#         saytime --print    # print instead of speak (for testing/cron debug)
#
# Driven by cron every 15 minutes — see macos/cron/README.md.

set -uo pipefail

# %-I strips the leading zero (2, not 02). %p is AM/PM.
# On the hour, drop ":00" — "It's 2 PM" reads better than "It's 2:00 PM".
if [[ $(date '+%M') == "00" ]]; then
    phrase="It's $(date '+%-I %p')"
else
    phrase="It's $(date '+%-I:%M %p')"
fi

if [[ ${1:-} == "--print" ]]; then
    echo "$phrase"
    exit 0
fi

exec /usr/bin/say "$phrase"
