  "effortLevel": "medium",
  "advisorModel": "opus",
  "autoUpdatesChannel": "latest",
  "tui": "default",
  "skipWorkflowUsageWarning": true,
  "editorMode": "normal",
  "autoCompactEnabled": true,
  "teammateMode": "auto",
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
