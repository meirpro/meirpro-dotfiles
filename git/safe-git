#!/usr/bin/env bash
#
# safe-git — wrapper that intercepts dangerous `git` invocations before
# they reach the real binary. Symlinked into ~/bin/git so PATH lookup
# resolves here first; we forward everything safe to the real git.
#
# Why a wrapper, not a git hook: git has no `pre-add` hook, and a
# `pre-commit` hook can't tell whether files were staged via `-A` or by
# explicit list (the index has the files, not the flags that put them
# there). The only place we can refuse `git add -A` at the binary level
# is between the shell and git itself — that's this wrapper.
#
# Rules enforced:
#   1. `git add -A` (any spelling) — refused.
#   2. `git add .`  — refused.
#   3. Bare `git add` (no pathspec) — refused. Stage by explicit name.
#   4. `git add` records a STAGE TOKEN: the repo it ran in and the
#      exact set of paths it left staged. (It no longer refuses an add
#      that isn't textually chained to a commit — see #5 for why.)
#   5. `git commit` (or `git commit -a`) is refused unless a fresh
#      stage token from this process ancestry exists, for THIS repo,
#      whose recorded staged set still MATCHES the index exactly.
#      Tokens are single-use and expire after STAGE_TOKEN_TTL.
#
#      This replaced a text-match over the parent shell's command line
#      on 2026-07-23 — that approach was forgeable by a comment (see
#      the Stage token section below). The state check is strictly
#      stronger against the real threat: a parallel agent staging its
#      own files between your add and your commit now changes the
#      staged set, so the commit is refused. It is deliberately weaker
#      in one place: a split `git add` … `git commit` from the same
#      shell is ALLOWED if the index is untouched in between, because
#      that is precisely the invariant the "same command" rule was a
#      proxy for.
#   6. `git reset --hard` with uncommitted changes in the working tree
#      or index — refused, so one session's "fast-forward to origin"
#      can't discard another's in-flight WIP (wiped 300+ lines on
#      2026-05-24).
#   7. `git checkout <branch>` / `git checkout -b` / `git switch ...`
#      (ANY HEAD-moving form) — refused. A checkout's branch is a
#      SHARED resource: parallel Claude sessions + the user all ride
#      one HEAD, so one agent switching/creating a branch silently
#      moves everyone (shipped: 2026-07-21, an agent created four
#      ship/* branches on the shared checkout while other agents were
#      working). File restores (`git checkout -- <path>`,
#      `git checkout <ref> -- <path>`) and `git restore` stay allowed;
#      `git worktree add` stays allowed (the sanctioned isolation).
#      Bypass — THE explicit-permission mechanism — is
#      `GIT_UNSAFE_BRANCH=1`, logged like the staging bypass.
#
# Bypass: prefix the command with `GIT_UNSAFE_STAGE=1` to disable the
# staging rules (1-5), or `GIT_UNSAFE_BRANCH=1` to allow one
# HEAD-moving checkout/switch (rule 7), for that single invocation.
# Both are logged to ~/.claude/git-bypass.log so they're not silent.
# Use GIT_UNSAFE_STAGE for legit imports of large folders;
# GIT_UNSAFE_BRANCH only with the user's explicit say-so.
#
# All other `git` invocations (status, diff, log, push, etc.) pass
# through unchanged.

set -eu

# Locate the real git. We chase PATH and skip ourselves so we can't
# infinite-loop. Hard-coded fallbacks cover the homebrew + system
# locations on macOS and Linux.
WRAPPER_PATH="$(readlink -f "$0" 2>/dev/null || python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$0")"
find_real_git() {
    local IFS=':'
    for dir in $PATH; do
        local candidate="$dir/git"
        [ -x "$candidate" ] || continue
        local resolved="$(readlink -f "$candidate" 2>/dev/null || python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$candidate")"
        [ "$resolved" = "$WRAPPER_PATH" ] && continue
        echo "$candidate"
        return 0
    done
    for hard in /opt/homebrew/bin/git /usr/local/bin/git /usr/bin/git; do
        [ -x "$hard" ] && { echo "$hard"; return 0; }
    done
    return 1
}

REAL_GIT="$(find_real_git || true)"
if [ -z "${REAL_GIT:-}" ]; then
    echo "safe-git: cannot find real git binary on PATH or in standard locations" >&2
    exit 127
fi

STAGE_TOKEN_TTL=60           # seconds a stage token stays valid (see below)

# ─────────────────────────────────────────────────────────────────
# --selftest — is the wrapper actually in force?
# ─────────────────────────────────────────────────────────────────
# Every rule here depends on PATH resolving `git` to this wrapper. A
# later PATH edit that puts /opt/homebrew/bin ahead of ~/bin disables
# ALL of them silently — no error, no warning, git just behaves
# normally again. This check must run before the subcommand dispatch
# below, or `--selftest` would be forwarded to the real git.
if [ "${1:-}" = "--selftest" ]; then
    fail=0
    printf 'safe-git selftest\n'
    printf '  wrapper:   %s\n' "$WRAPPER_PATH"
    printf '  real git:  %s\n' "$REAL_GIT"

    resolved="$(command -v git 2>/dev/null || true)"
    resolved_real=""
    if [ -n "$resolved" ]; then
        resolved_real="$(readlink -f "$resolved" 2>/dev/null \
            || python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$resolved" 2>/dev/null \
            || true)"
    fi
    if [ "$resolved_real" = "$WRAPPER_PATH" ]; then
        printf '  PATH:      OK — git resolves to the wrapper (%s)\n' "$resolved"
    else
        printf '  PATH:      FAIL — git resolves to %s\n' "${resolved:-<nothing>}"
        printf '             Rules are NOT in force. Put ~/bin ahead of %s.\n' "$(dirname "$REAL_GIT")"
        fail=1
    fi

    if mkdir -p "$HOME/.cache" 2>/dev/null && [ -w "$HOME/.cache" ]; then
        printf '  tokens:    OK — ~/.cache writable, TTL %ss\n' "$STAGE_TOKEN_TTL"
    else
        printf '  tokens:    FAIL — ~/.cache not writable; rule 5 cannot verify stages\n'
        fail=1
    fi

    printf '  rules:     1-3 add form | 4-5 stage token | 6 reset --hard | 7 HEAD moves\n'
    if [ "$fail" -eq 0 ]; then
        printf '  result:    all checks passed\n'
    else
        printf '  result:    PROBLEMS FOUND\n'
    fi
    exit "$fail"
fi

# Detect the subcommand (first non-option arg). Skip global flags like
# `git -c foo=bar add ...` so the rules still apply.
SUBCMD=""
i=1
while [ $i -le $# ]; do
    eval "arg=\${$i}"
    case "$arg" in
        -*) ;;                  # global flag, keep scanning
        *) SUBCMD="$arg"; break ;;
    esac
    i=$((i + 1))
done

# Only interesting subcommands: add, commit, reset, checkout, switch.
# Everything else passes through.
case "$SUBCMD" in
    add|commit|reset|checkout|switch) ;;
    *) exec "$REAL_GIT" "$@" ;;
esac

# Which env var can bypass the rule that applies to this subcommand.
# SCOPED on purpose: GIT_UNSAFE_STAGE must not smuggle a branch move
# past rule 7, and GIT_UNSAFE_BRANCH must not smuggle an `add -A`
# past rules 1-5 — each bypass unlocks exactly its own rule family.
case "$SUBCMD" in
    checkout|switch) BYPASS_VAR="GIT_UNSAFE_BRANCH" ;;
    *)               BYPASS_VAR="GIT_UNSAFE_STAGE" ;;
esac

# Bypass — log the exception, then exec the real git directly.
eval "BYPASS_SET=\${$BYPASS_VAR:-}"
if [ "$BYPASS_SET" = "1" ]; then
    LOG="$HOME/.claude/git-bypass.log"
    mkdir -p "$(dirname "$LOG")" 2>/dev/null || true
    {
        printf '[%s] %s cwd=%s argv=' "$(date '+%Y-%m-%d %H:%M:%S')" "$BYPASS_VAR" "$(pwd)"
        for a in "$@"; do printf '%q ' "$a"; done
        printf '\n'
    } >> "$LOG" 2>/dev/null || true
    exec "$REAL_GIT" "$@"
fi

# ─────────────────────────────────────────────────────────────────
# Stage token — how rules 4 and 5 know a commit belongs to its add.
# ─────────────────────────────────────────────────────────────────
#
# These rules used to work by TEXT-MATCHING the parent process's
# command line for `git add ... && ... git commit`. That was unsound:
# `bash -c '<one simple command>'` makes bash *exec* rather than fork,
# so $PPID skipped past bash to the outer shell — and for a Claude Code
# agent that shell's argv is the agent's ENTIRE script. Any occurrence
# of the pattern anywhere in it — a comment, an echo, a doc string —
# authorised every add/commit in that script. Demonstrated 2026-07-23:
#
#   # comment mentioning: git add foo.txt && git commit -m "x"
#   bash -c 'git commit -m "authorised-by-a-comment" --allow-empty'
#   -> committed, rule 5 never fired.
#
# So we no longer parse text. We verify STATE, which comments cannot
# forge: `git add` records what it actually staged, and `git commit`
# refuses unless the index still matches that record exactly.
#
# This also detects the real threat the text rule only approximated —
# a parallel agent slipping files into the index between your stage
# and your commit changes the staged set, so the commit is refused.
#
# Consequence: shell/safe-git-hook.sh is now obsolete. It existed only
# to expose the typed command line on interactive macOS shells. Nothing
# reads it any more, and the 10-second capture window is gone with it.

# (STAGE_TOKEN_TTL is defined near the top, so --selftest can report it.)

# Token path for a given pid.
stage_token_path() { printf '%s/.cache/safe-git-stage-%s' "$HOME" "$1"; }

# Identity of the repo we're operating on, so a token from repo A can
# never authorise a commit in repo B.
repo_ident() {
    "$REAL_GIT" rev-parse --absolute-git-dir 2>/dev/null || printf 'NO_REPO'
}

# The exact set of staged paths, sorted for a stable comparison.
staged_set() {
    "$REAL_GIT" diff --cached --name-only 2>/dev/null | LC_ALL=C sort
}

# Walk our process ancestry looking for a fresh, same-repo token.
# Ancestry (not just $PPID) so `(git add f && git commit -m m)` in a
# subshell still finds the token its sibling wrote.
find_stage_token() {
    local now p tok mtime age
    now="$(date +%s 2>/dev/null)" || return 1
    p="$PPID"
    while [ -n "$p" ] && [ "$p" != "1" ] && [ "$p" != "0" ]; do
        tok="$(stage_token_path "$p")"
        if [ -f "$tok" ]; then
            mtime="$(stat -f %m "$tok" 2>/dev/null || stat -c %Y "$tok" 2>/dev/null)"
            if [ -n "$mtime" ]; then
                age=$((now - mtime))
                if [ "$age" -ge 0 ] && [ "$age" -le "$STAGE_TOKEN_TTL" ]; then
                    printf '%s' "$tok"
                    return 0
                fi
            fi
        fi
        p="$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')"
    done
    return 1
}

deny() {
    # $1 = reason, $2 = explanation, remaining args = original git argv
    local reason="$1" explain="$2"
    shift 2
    cat >&2 <<EOF
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
 git safety wrapper REFUSED this command.

 Reason: $reason

$explain

 Bypass (use sparingly):
   ${BYPASS_VAR:-GIT_UNSAFE_STAGE}=1 git $(printf '%q ' "$@" | sed 's/ $//')

   Note: env-var prefix only applies to the FIRST command. To bypass
   an \`add && commit\` chain, wrap both in one bash -c:
     GIT_UNSAFE_STAGE=1 bash -c 'git add <file> && git commit -m "msg"'

   Or use bash -c WITHOUT bypass — the wrapper sees the pipeline in
   bash's argv and allows the chain natively:
     bash -c 'git add <file> && git commit -m "msg"'

 Disable wrapper entirely:
   $REAL_GIT ...   # call real git by full path
   # or remove ~/bin/git (the symlink) — the rule lives in
   # $WRAPPER_PATH
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
EOF
    exit 64  # EX_USAGE
}

# ─────────────────────────────────────────────────────────────────
# Rule 1+2+3+4: subcommand == add
# ─────────────────────────────────────────────────────────────────
if [ "$SUBCMD" = "add" ]; then
    # Walk add's args looking for forbidden tokens.
    saw_files=0
    j=1
    while [ $j -le $# ]; do
        eval "a=\${$j}"
        case "$a" in
            add) ;;                              # the subcommand itself
            -A|--all|--no-ignore-removal) deny "git add -A is forbidden — stage explicit file paths." \
                "Why: -A stages every changed file in the tree, including ones edited by other parallel agents or generated artifacts. Stage by name:
   git add path/to/file1 path/to/file2 && git commit -m \"msg\"" "$@" ;;
            .)                                    deny "git add . is forbidden — stage explicit file paths." \
                "Why: '.' stages everything under the current directory, including unrelated changes you didn't make. Stage by name:
   git add path/to/file1 path/to/file2 && git commit -m \"msg\"" "$@" ;;
            -*) ;;                                # other flags (-p, --intent-to-add, etc.) pass
            *) saw_files=1 ;;                     # an explicit path
        esac
        j=$((j + 1))
    done

    if [ $saw_files -eq 0 ]; then
        deny "bare 'git add' with no file arguments." \
            "Why: nothing to stage. If you meant 'add everything', that's exactly what's forbidden — stage by explicit name:
   git add path/to/file1 path/to/file2 && git commit -m \"msg\"" "$@"
    fi

    # Atomicity is enforced on the COMMIT side now (rule 5), by
    # comparing the index against what this add actually staged. So
    # here we just do the add and record the resulting staged set.
    #
    # Note we deliberately do NOT `exec` — we need control back to
    # write the token. Git's exit status is preserved either way.
    if "$REAL_GIT" "$@"; then
        add_status=0
    else
        add_status=$?
    fi
    [ "$add_status" -eq 0 ] || exit "$add_status"

    tok="$(stage_token_path "$PPID")"
    mkdir -p "$(dirname "$tok")" 2>/dev/null || true
    (
        umask 077
        {
            printf 'repo=%s\n' "$(repo_ident)"
            printf -- '--\n'
            staged_set
        } > "$tok"
    ) 2>/dev/null || true
    exit 0
fi

# ─────────────────────────────────────────────────────────────────
# Rule 5: subcommand == commit
# ─────────────────────────────────────────────────────────────────
if [ "$SUBCMD" = "commit" ]; then
    # Detect whether this is the COMMIT half of an `add ... && commit`
    # one-liner (allowed) or a bare `git commit` (forbidden). Rule:
    # parent shell command must contain `git add ` BEFORE this commit.
    # Also reject `git commit -a` outright — that's the same foot-gun
    # as `add -A`.
    for a in "$@"; do
        case "$a" in
            -a|--all|-am|-am*|-a*m|-Am)
                deny "'git commit -a' is forbidden — it's 'git add -A' in disguise." \
                    "Why: -a auto-stages every modified tracked file, exactly the over-staging we banned. Stage by name:
   git add path/to/file1 path/to/file2 && git commit -m \"msg\"" "$@" ;;
        esac
    done

    # State check, not a text check. A stage token is written by rule 4
    # when `git add` runs; it records the repo and the exact staged set.
    # We require a fresh token from our own process ancestry, for THIS
    # repo, whose recorded set still matches the index.
    tok="$(find_stage_token 2>/dev/null || true)"

    if [ -z "$tok" ]; then
        deny "'git commit' must be preceded by 'git add <files>' in the same shell command." \
            "Why: a bare 'git commit' ships whatever was staged on a prior turn — possibly by another agent. Combine stage + commit:
   git add path/to/file1 path/to/file2 && git commit -m \"msg\"" "$@"
    fi

    tok_repo="$(sed -n 's/^repo=//p' "$tok" 2>/dev/null | head -1)"
    if [ "$tok_repo" != "$(repo_ident)" ]; then
        rm -f "$tok" 2>/dev/null || true
        deny "the pending 'git add' was for a different repository." \
            "Why: a stage token from another checkout must never authorise a commit here. Stage and commit in the same repo:
   git add path/to/file1 path/to/file2 && git commit -m \"msg\"" "$@"
    fi

    # Everything after the '--' marker is the staged set as it was
    # immediately after the add.
    tok_files="$(sed -n '/^--$/,$p' "$tok" 2>/dev/null | tail -n +2)"
    now_files="$(staged_set)"
    if [ "$tok_files" != "$now_files" ]; then
        deny "the staged file set changed between 'git add' and 'git commit'." \
            "Why: something modified the index after you staged — typically a parallel agent adding its own files, which your commit would then ship. This is exactly the race the atomic stage+commit rule exists to stop.

 Re-stage explicitly and commit in one command:
   git add path/to/file1 path/to/file2 && git commit -m \"msg\"

 Staged when you added:
$(printf '%s' "$tok_files" | sed 's/^/   /')

 Staged now:
$(printf '%s' "$now_files" | sed 's/^/   /')" "$@"
    fi

    # Single use — a token must never authorise a second commit.
    rm -f "$tok" 2>/dev/null || true
fi

# ─────────────────────────────────────────────────────────────────
# Rule 6: subcommand == reset
# ─────────────────────────────────────────────────────────────────
# `git reset --hard` discards uncommitted working-tree changes
# silently. When multiple Claude sessions or agents share a checkout
# (the normal case in this repo), one agent's "fast-forward to merged
# origin" can blow away another agent's in-flight WIP — exactly the
# pattern that wiped 300+ lines of manifest code on 2026-05-24 when
# a parallel agent ran `git reset --hard origin/staging/partition-done`
# after merging PR #85. Refuse `reset --hard` whenever the working
# tree (or index) has uncommitted changes; force the caller to deal
# with the WIP explicitly first.
if [ "$SUBCMD" = "reset" ]; then
    saw_hard=0
    for a in "$@"; do
        case "$a" in
            --hard) saw_hard=1 ;;
        esac
    done

    if [ "$saw_hard" = "1" ]; then
        # Check for any uncommitted change: staged, unstaged, OR
        # untracked. Untracked matters because `reset --hard <ref>`
        # itself doesn't delete untracked files, BUT a typical
        # "clean slate" sequence pairs it with `git clean -fd` which
        # does — so we surface the dirty state regardless and let
        # the caller make an informed choice.
        DIRTY="$("$REAL_GIT" status --porcelain 2>/dev/null || true)"
        if [ -n "$DIRTY" ]; then
            COUNT=$(printf '%s\n' "$DIRTY" | wc -l | tr -d ' ')
            FILES="$(printf '%s\n' "$DIRTY" | head -6 | sed 's/^/   /')"
            EXTRA=""
            if [ "$COUNT" -gt 6 ]; then
                EXTRA="$(printf '%s\n' "   ... and $((COUNT - 6)) more")"
            fi
            deny "'git reset --hard' with uncommitted changes in the working tree." \
                "Why: --hard silently throws away unstaged + staged work. If a parallel agent / sibling session is mid-edit on these files, you would erase their WIP without warning.

 Dirty files ($COUNT):
$FILES
$EXTRA

 Resolve first:
   1. If the WIP is yours and unneeded:    git stash -u   (then 'git stash drop' later — NOT 'git stash pop' if you've already reset)
   2. If you want it to survive:           git stash -u && git reset --hard <ref> && git stash pop
   3. If you don't know whose WIP it is:   stop and ask the user — another session may be active." "$@"
        fi
    fi
fi

# ─────────────────────────────────────────────────────────────────
# Rule 7: subcommand == checkout | switch (HEAD-moving forms)
# ─────────────────────────────────────────────────────────────────
# A checkout's branch is a SHARED resource: parallel Claude sessions,
# other agents, and the user all share one HEAD in a given working
# dir. One agent creating/switching a branch silently moves EVERYONE
# — their edits start landing on the wrong branch (shipped 2026-07-21:
# an agent minted four ship/* branches on the shared CRM checkout to
# imitate `npm run ship` while other agents were mid-work).
#
# Allowed without bypass:
#   git checkout -- <path>            (file restore — no HEAD move)
#   git checkout <ref> -- <path>      (file restore from a ref)
#   git restore ... / git worktree add (different subcommands — the
#                                       worktree is the sanctioned
#                                       isolation for branch work)
# Everything else under checkout/switch moves (or can move) HEAD and
# is refused. The bypass IS the explicit-permission mechanism: get the
# user's say-so, then prefix `GIT_UNSAFE_BRANCH=1`.
if [ "$SUBCMD" = "checkout" ] || [ "$SUBCMD" = "switch" ]; then
    # (GIT_UNSAFE_BRANCH=1 is handled by the scoped bypass block above.)
    if [ "$SUBCMD" = "checkout" ]; then
        # `--` marks the pathspec form — a file restore, not a HEAD move.
        for a in "$@"; do
            if [ "$a" = "--" ]; then
                exec "$REAL_GIT" "$@"
            fi
        done
    fi

    deny "'git $SUBCMD' moves the shared checkout's HEAD — forbidden without explicit user permission." \
        "Why: this working dir's branch is shared by parallel Claude sessions, other agents, and the user. Creating or switching branches here silently moves ALL of them — their edits land on your branch (this shipped 2026-07-21).

 Do one of these instead:
   1. Work on the branch the checkout is already on.
   2. Need isolation? Use a git worktree (allowed, isolated HEAD):
        git worktree add .claude/worktrees/<name> -b <branch>
   3. Restoring a FILE (not switching)?  git checkout -- <path>   or   git restore <path>
   4. The user explicitly approved a branch move? Use the logged bypass:
        GIT_UNSAFE_BRANCH=1 git $(printf '%q ' "$@" | sed 's/ $//')" "$@"
fi

# All checks passed — forward to the real git.
exec "$REAL_GIT" "$@"
