#!/usr/bin/env bash
#
# safe-git — wrapper that intercepts dangerous `git` invocations before
# they reach the real binary. Symlinked into ~/bin/git so PATH lookup
# resolves here first; we forward everything safe to the real git.
#
# Why a wrapper, not a git hook: git has no `pre-add` hook, and a
# `pre-commit` hook can't tell whether files were staged via `-A` or by
# explicit list (the index has the files, not the flags that put them
# there). The only place we can refuse `git add -A` at the binary level
# is between the shell and git itself — that's this wrapper.
#
# Rules enforced:
#   1. `git add -A` (any spelling) — refused.
#   2. `git add .`  — refused.
#   3. Bare `git add` (no pathspec) — refused. Stage by explicit name.
#   4. `git add` records a STAGE TOKEN: the repo it ran in and the
#      exact set of paths it left staged. (It no longer refuses an add
#      that isn't textually chained to a commit — see #5 for why.)
#   5. `git commit` (or `git commit -a`) is refused unless a fresh
#      stage token from this process ancestry exists, for THIS repo,
#      whose recorded staged set still MATCHES the index exactly.
#      Tokens are single-use and expire after STAGE_TOKEN_TTL.
#
#      This replaced a text-match over the parent shell's command line
#      on 2026-07-23 — that approach was forgeable by a comment (see
#      the Stage token section below). The state check is strictly
#      stronger against the real threat: a parallel agent staging its
#      own files between your add and your commit now changes the
#      staged set, so the commit is refused. It is deliberately weaker
#      in one place: a split `git add` … `git commit` from the same
#      shell is ALLOWED if the index is untouched in between, because
#      that is precisely the invariant the "same command" rule was a
#      proxy for.
#  11. `git commit` with NO pathspec, when the index holds files this
#      shell's `git add` did not name — refused. Rules 4-5 model a
#      parallel agent staging BETWEEN your add and your commit; they
#      are blind to work that was already staged when you arrived,
#      because the index records no authorship. `git commit` commits
#      the INDEX, and the index is the one shared resource these rules
#      did not attribute. Shipped 2026-08-23: a session staged two
#      files, committed, and swept in fourteen deleted files another
#      session had staged earlier — every earlier rule passed.
#      The token now also records the paths YOUR add named, so the
#      commit can tell them apart. `git commit <paths>` stays allowed:
#      it ignores the rest of the index by construction.
#
#   6. `git reset --hard` with uncommitted changes in the working tree
#      or index — refused, so one session's "fast-forward to origin"
#      can't discard another's in-flight WIP (wiped 300+ lines on
#      2026-05-24).
#   7. `git checkout <branch>` / `git checkout -b` / `git switch ...`
#      (ANY HEAD-moving form) — refused. A checkout's branch is a
#      SHARED resource: parallel Claude sessions + the user all ride
#      one HEAD, so one agent switching/creating a branch silently
#      moves everyone (shipped: 2026-07-21, an agent created four
#      ship/* branches on the shared checkout while other agents were
#      working). File restores (`git checkout -- <path>`,
#      `git checkout <ref> -- <path>`) and `git restore` stay allowed;
#      `git worktree add` stays allowed (the sanctioned isolation),
#      but only inside `.claude/worktrees/` — see rule 9.
#      Bypass — THE explicit-permission mechanism — is
#      `GIT_UNSAFE_BRANCH=1`, logged like the staging bypass.
#   9. `git worktree add <path>` outside `.claude/worktrees/` —
#      refused. Worktrees are scratch isolation, not projects: they
#      belong inside the repo they came from, where one gitignore
#      rule hides them and `git worktree remove` is the obvious
#      cleanup. A sibling directory next to the repo reads like a
#      separate checkout, survives long past its branch, and gets
#      committed into the parent by accident (2026-07-29: an agent
#      created `perfume-machine-backend-integration/` beside its repo
#      and it was mistaken for a second project). Relative paths are
#      resolved against the cwd before the check, so `../foo` can't
#      sneak out. Bypass: `GIT_UNSAFE_BRANCH=1`.
#  10. Rewriting the commit identity — refused, in all three forms:
#      `-c user.email=` / `-c user.name=` / `-c author.*` / `-c
#      committer.*` (any subcommand), `git commit --author=`, and the
#      GIT_AUTHOR_* / GIT_COMMITTER_* environment variables. This
#      machine's identity is a GitHub noreply address on purpose, so
#      the real one never reaches public history; an agent overrode it
#      on seven commits across two repos on 2026-08-23, one of them
#      public, and undoing it took a filter-branch + reflog expiry + gc
#      in both. Bypass: `GIT_UNSAFE_IDENTITY=1`, logged.
#
#      Fixing rule 10 also closed a hole that defeated rules 1-9: the
#      global-flag scanner did not know that `-c` takes its value as a
#      SEPARATE argument, so it read `user.email=x` as the subcommand,
#      matched nothing, and passed the whole command through to real
#      git. `git -c anything=x add .` was allowed. Flags that consume a
#      following value now advance the scanner past it.
#
# Bypass: prefix the command with `GIT_UNSAFE_STAGE=1` to disable the
# staging rules (1-5), or `GIT_UNSAFE_BRANCH=1` to allow one
# HEAD-moving checkout/switch (rule 7), for that single invocation.
# Both are logged to ~/.claude/git-bypass.log so they're not silent.
# Use GIT_UNSAFE_STAGE for legit imports of large folders;
# GIT_UNSAFE_BRANCH only with the user's explicit say-so.
#
# All other `git` invocations (status, diff, log, push, etc.) pass
# through unchanged.

set -eu

# Locate the real git. We chase PATH and skip ourselves so we can't
# infinite-loop. Hard-coded fallbacks cover the homebrew + system
# locations on macOS and Linux.
WRAPPER_PATH="$(readlink -f "$0" 2>/dev/null || python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$0")"
find_real_git() {
    local IFS=':'
    for dir in $PATH; do
        local candidate="$dir/git"
        [ -x "$candidate" ] || continue
        local resolved="$(readlink -f "$candidate" 2>/dev/null || python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$candidate")"
        [ "$resolved" = "$WRAPPER_PATH" ] && continue
        echo "$candidate"
        return 0
    done
    for hard in /opt/homebrew/bin/git /usr/local/bin/git /usr/bin/git; do
        [ -x "$hard" ] && { echo "$hard"; return 0; }
    done
    return 1
}

REAL_GIT="$(find_real_git || true)"
if [ -z "${REAL_GIT:-}" ]; then
    echo "safe-git: cannot find real git binary on PATH or in standard locations" >&2
    exit 127
fi

STAGE_TOKEN_TTL=60           # seconds a stage token stays valid (see below)

# Defined up here, not next to the rules, because rule 10 fires during the
# subcommand scan — before any of the rule sections below exist.
deny() {
    # $1 = reason, $2 = explanation, remaining args = original git argv
    local reason="$1" explain="$2"
    shift 2
    cat >&2 <<EOF
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
 git safety wrapper REFUSED this command.

 Reason: $reason

$explain

 Bypass (use sparingly):
   ${BYPASS_VAR:-GIT_UNSAFE_STAGE}=1 git $(printf '%q ' "$@" | sed 's/ $//')

   Note: env-var prefix only applies to the FIRST command. To bypass
   an \`add && commit\` chain, wrap both in one bash -c:
     GIT_UNSAFE_STAGE=1 bash -c 'git add <file> && git commit -m "msg"'

   Or use bash -c WITHOUT bypass — the wrapper sees the pipeline in
   bash's argv and allows the chain natively:
     bash -c 'git add <file> && git commit -m "msg"'

 Disable wrapper entirely:
   $REAL_GIT ...   # call real git by full path
   # or remove ~/bin/git (the symlink) — the rule lives in
   # $WRAPPER_PATH
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
EOF
    exit 64  # EX_USAGE
}

# ─────────────────────────────────────────────────────────────────
# --selftest — is the wrapper actually in force?
# ─────────────────────────────────────────────────────────────────
# Every rule here depends on PATH resolving `git` to this wrapper. A
# later PATH edit that puts /opt/homebrew/bin ahead of ~/bin disables
# ALL of them silently — no error, no warning, git just behaves
# normally again. This check must run before the subcommand dispatch
# below, or `--selftest` would be forwarded to the real git.
if [ "${1:-}" = "--selftest" ]; then
    fail=0
    printf 'safe-git selftest\n'
    printf '  wrapper:   %s\n' "$WRAPPER_PATH"
    printf '  real git:  %s\n' "$REAL_GIT"

    resolved="$(command -v git 2>/dev/null || true)"
    resolved_real=""
    if [ -n "$resolved" ]; then
        resolved_real="$(readlink -f "$resolved" 2>/dev/null \
            || python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$resolved" 2>/dev/null \
            || true)"
    fi
    if [ "$resolved_real" = "$WRAPPER_PATH" ]; then
        printf '  PATH:      OK — git resolves to the wrapper (%s)\n' "$resolved"
    else
        printf '  PATH:      FAIL — git resolves to %s\n' "${resolved:-<nothing>}"
        printf '             Rules are NOT in force. Put ~/bin ahead of %s.\n' "$(dirname "$REAL_GIT")"
        fail=1
    fi

    if mkdir -p "$HOME/.cache" 2>/dev/null && [ -w "$HOME/.cache" ]; then
        printf '  tokens:    OK — ~/.cache writable, TTL %ss\n' "$STAGE_TOKEN_TTL"
    else
        printf '  tokens:    FAIL — ~/.cache not writable; rule 5 cannot verify stages\n'
        fail=1
    fi

    printf '  rules:     1-3 add form | 4-5 stage token | 6 reset --hard | 7 HEAD moves\n'
    printf '             8 whole-tree stash | 9 worktree location | 10 commit identity\n'
    printf '             11 commit ships only what you staged\n'

    # Rule 10 protects a specific value, so show what it is protecting.
    printf '  identity:  %s <%s>\n' \
        "$("$REAL_GIT" config user.name  2>/dev/null || echo '<unset>')" \
        "$("$REAL_GIT" config user.email 2>/dev/null || echo '<unset>')"
    if [ "$fail" -eq 0 ]; then
        printf '  result:    all checks passed\n'
    else
        printf '  result:    PROBLEMS FOUND\n'
    fi
    exit "$fail"
fi

# Detect the subcommand (first non-option arg), skipping global flags.
#
# CRITICAL: some global flags take their value as a SEPARATE argument, and an
# earlier version of this scanner didn't know that. It saw `-c`, skipped it as
# a flag, then read the NEXT arg — `user.email=x` — as the subcommand. That
# matches nothing in the dispatch below, so the command fell straight through
# to the real git. Every rule in this file was defeatable by prefixing any
# `-c anything=x`:
#
#   git add .                     -> refused
#   git -c user.email=x add .     -> ALLOWED, staged everything
#
# Verified as a live hole on 2026-08-23. The same trick bypassed `commit -a`,
# `reset --hard`, branch switches and whole-tree stash. Flags that consume a
# following value must therefore advance the index past it.
SUBCMD=""
IDENTITY_OVERRIDE=""

# Config keys that rewrite who a commit claims to be from. Compared
# lowercased: git treats config section and key names case-insensitively, so
# `-c User.Email=x` is the same setting as `-c user.email=x`.
is_identity_key() {
    case "$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')" in
        user.email=*|user.name=*|author.*|committer.*) return 0 ;;
    esac
    return 1
}

i=1
while [ $i -le $# ]; do
    eval "arg=\${$i}"
    case "$arg" in
        -c|--config-env)
            # Value is the NEXT argument — inspect it, then step over it.
            i=$((i + 1))
            eval "cval=\${$i:-}"
            is_identity_key "$cval" && IDENTITY_OVERRIDE="$arg $cval"
            ;;
        --config-env=*)
            is_identity_key "${arg#--config-env=}" && IDENTITY_OVERRIDE="$arg"
            ;;
        -c*)
            # Attached form, e.g. -cuser.email=x
            is_identity_key "${arg#-c}" && IDENTITY_OVERRIDE="$arg"
            ;;
        -C|--git-dir|--work-tree|--namespace|--super-prefix|--attr-source)
            i=$((i + 1)) ;;     # these also consume a following value
        -*) ;;                  # value-less global flag, keep scanning
        *) SUBCMD="$arg"; break ;;
    esac
    i=$((i + 1))
done

# ─────────────────────────────────────────────────────────────────
# Rule 10: no rewriting commit identity
# ─────────────────────────────────────────────────────────────────
# `git -c user.email=... commit` overrides the configured identity for one
# command, silently and with no trace in the result beyond the commit itself.
#
# This machine's git identity is deliberately a GitHub noreply address so that
# the real address never lands in public history. On 2026-08-23 an agent passed
# `-c user.email=<real address>` on seven commits across two repos, one of them
# a PUBLIC dotfiles repo. They were caught before being pushed; rewriting them
# afterwards cost a filter-branch, a reflog expiry and a gc in both repos.
#
# There is no legitimate reason for an agent to override this. If the
# configured identity is wrong, fix the config — don't override per-command.
if [ -n "$IDENTITY_OVERRIDE" ] && [ "${GIT_UNSAFE_IDENTITY:-}" = "1" ]; then
    # Bypassed, but never silently — same logging as the other bypasses.
    IDLOG="$HOME/.claude/git-bypass.log"
    mkdir -p "$(dirname "$IDLOG")" 2>/dev/null || true
    {
        printf '[%s] GIT_UNSAFE_IDENTITY cwd=%s argv=' "$(date '+%Y-%m-%d %H:%M:%S')" "$(pwd)"
        for a in "$@"; do printf '%q ' "$a"; done
        printf '\n'
    } >> "$IDLOG" 2>/dev/null || true
    IDENTITY_OVERRIDE=""
fi

if [ -n "$IDENTITY_OVERRIDE" ]; then
    BYPASS_VAR="GIT_UNSAFE_IDENTITY"
    deny "'git $IDENTITY_OVERRIDE' rewrites the commit identity." \
        "Why: it silently attributes commits to someone other than this machine's configured author. The identity here is a GitHub noreply address on purpose, so a real email can never reach public history. An agent overrode it on seven commits on 2026-08-23; undoing that needed a history rewrite in two repos.

 Configured identity (what you get by NOT overriding):
   $("$REAL_GIT" config user.name 2>/dev/null || echo '<unset>') <$("$REAL_GIT" config user.email 2>/dev/null || echo '<unset>')>

 Do this instead:
   git commit -m \"msg\"                      # use the configured identity
   git config --global user.email <addr>     # if the config itself is wrong" "$@"
fi

# Only interesting subcommands: add, commit, reset, checkout, switch.
# Everything else passes through.
case "$SUBCMD" in
    add|commit|reset|checkout|switch|stash|worktree) ;;
    *) exec "$REAL_GIT" "$@" ;;
esac

# Exemption: Claude Code's plugin cache. The installer clones each
# plugin's marketplace repo under ~/.claude/plugins/ and pins it with
# `git checkout <sha>`. Those clones are machine-managed caches, not
# shared working checkouts — no session, agent, or human rides their
# HEAD — so none of the rules below apply there (blocked a plugin
# install on 2026-07-24). Scoped by the repo's actual git-dir, so a
# cwd trick can't extend it to a real checkout.
PLUGIN_GITDIR="$("$REAL_GIT" rev-parse --absolute-git-dir 2>/dev/null || true)"
case "$PLUGIN_GITDIR" in
    "$HOME/.claude/plugins/"*) exec "$REAL_GIT" "$@" ;;
esac

# Which env var can bypass the rule that applies to this subcommand.
# SCOPED on purpose: GIT_UNSAFE_STAGE must not smuggle a branch move
# past rule 7, and GIT_UNSAFE_BRANCH must not smuggle an `add -A`
# past rules 1-5 — each bypass unlocks exactly its own rule family.
case "$SUBCMD" in
    checkout|switch|worktree) BYPASS_VAR="GIT_UNSAFE_BRANCH" ;;
    *)                        BYPASS_VAR="GIT_UNSAFE_STAGE" ;;
esac

# Bypass — log the exception, then exec the real git directly.
eval "BYPASS_SET=\${$BYPASS_VAR:-}"
if [ "$BYPASS_SET" = "1" ]; then
    LOG="$HOME/.claude/git-bypass.log"
    mkdir -p "$(dirname "$LOG")" 2>/dev/null || true
    {
        printf '[%s] %s cwd=%s argv=' "$(date '+%Y-%m-%d %H:%M:%S')" "$BYPASS_VAR" "$(pwd)"
        for a in "$@"; do printf '%q ' "$a"; done
        printf '\n'
    } >> "$LOG" 2>/dev/null || true
    exec "$REAL_GIT" "$@"
fi

# ─────────────────────────────────────────────────────────────────
# Stage token — how rules 4 and 5 know a commit belongs to its add.
# ─────────────────────────────────────────────────────────────────
#
# These rules used to work by TEXT-MATCHING the parent process's
# command line for `git add ... && ... git commit`. That was unsound:
# `bash -c '<one simple command>'` makes bash *exec* rather than fork,
# so $PPID skipped past bash to the outer shell — and for a Claude Code
# agent that shell's argv is the agent's ENTIRE script. Any occurrence
# of the pattern anywhere in it — a comment, an echo, a doc string —
# authorised every add/commit in that script. Demonstrated 2026-07-23:
#
#   # comment mentioning: git add foo.txt && git commit -m "x"
#   bash -c 'git commit -m "authorised-by-a-comment" --allow-empty'
#   -> committed, rule 5 never fired.
#
# So we no longer parse text. We verify STATE, which comments cannot
# forge: `git add` records what it actually staged, and `git commit`
# refuses unless the index still matches that record exactly.
#
# This also detects the real threat the text rule only approximated —
# a parallel agent slipping files into the index between your stage
# and your commit changes the staged set, so the commit is refused.
#
# Consequence: shell/safe-git-hook.sh is now obsolete. It existed only
# to expose the typed command line on interactive macOS shells. Nothing
# reads it any more, and the 10-second capture window is gone with it.

# (STAGE_TOKEN_TTL is defined near the top, so --selftest can report it.)

# Token path for a given pid.
stage_token_path() { printf '%s/.cache/safe-git-stage-%s' "$HOME" "$1"; }

# Identity of the repo we're operating on, so a token from repo A can
# never authorise a commit in repo B.
repo_ident() {
    "$REAL_GIT" rev-parse --absolute-git-dir 2>/dev/null || printf 'NO_REPO'
}

# The exact set of staged paths, sorted for a stable comparison.
staged_set() {
    "$REAL_GIT" diff --cached --name-only 2>/dev/null | LC_ALL=C sort
}

# Walk our process ancestry looking for a fresh, same-repo token.
# Ancestry (not just $PPID) so `(git add f && git commit -m m)` in a
# subshell still finds the token its sibling wrote.
find_stage_token() {
    local now p tok mtime age
    now="$(date +%s 2>/dev/null)" || return 1
    p="$PPID"
    while [ -n "$p" ] && [ "$p" != "1" ] && [ "$p" != "0" ]; do
        tok="$(stage_token_path "$p")"
        if [ -f "$tok" ]; then
            mtime="$(stat -f %m "$tok" 2>/dev/null || stat -c %Y "$tok" 2>/dev/null)"
            if [ -n "$mtime" ]; then
                age=$((now - mtime))
                if [ "$age" -ge 0 ] && [ "$age" -le "$STAGE_TOKEN_TTL" ]; then
                    printf '%s' "$tok"
                    return 0
                fi
            fi
        fi
        p="$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')"
    done
    return 1
}

# ─────────────────────────────────────────────────────────────────
# Rule 1+2+3+4: subcommand == add
# ─────────────────────────────────────────────────────────────────
if [ "$SUBCMD" = "add" ]; then
    # Snapshot argv by index: `mine_set` below rebinds "$@" to build a
    # pathspec list, so the original arguments have to survive that.
    ARGC=$#
    i=1
    for a in "$@"; do
        eval "ARGV_$i=\$a"
        i=$((i + 1))
    done

    # Walk add's args looking for forbidden tokens.
    saw_files=0
    j=1
    while [ $j -le $# ]; do
        eval "a=\${$j}"
        case "$a" in
            add) ;;                              # the subcommand itself
            -A|--all|--no-ignore-removal) deny "git add -A is forbidden — stage explicit file paths." \
                "Why: -A stages every changed file in the tree, including ones edited by other parallel agents or generated artifacts. Stage by name:
   git add path/to/file1 path/to/file2 && git commit -m \"msg\"" "$@" ;;
            .)                                    deny "git add . is forbidden — stage explicit file paths." \
                "Why: '.' stages everything under the current directory, including unrelated changes you didn't make. Stage by name:
   git add path/to/file1 path/to/file2 && git commit -m \"msg\"" "$@" ;;
            -*) ;;                                # other flags (-p, --intent-to-add, etc.) pass
            *) saw_files=1 ;;                     # an explicit path
        esac
        j=$((j + 1))
    done

    if [ $saw_files -eq 0 ]; then
        deny "bare 'git add' with no file arguments." \
            "Why: nothing to stage. If you meant 'add everything', that's exactly what's forbidden — stage by explicit name:
   git add path/to/file1 path/to/file2 && git commit -m \"msg\"" "$@"
    fi

    # Atomicity is enforced on the COMMIT side now (rule 5), by
    # comparing the index against what this add actually staged. So
    # here we just do the add and record the resulting staged set.
    #
    # Note we deliberately do NOT `exec` — we need control back to
    # write the token. Git's exit status is preserved either way.
    if "$REAL_GIT" "$@"; then
        add_status=0
    else
        add_status=$?
    fi
    [ "$add_status" -eq 0 ] || exit "$add_status"

    # Which staged entries did THIS add name? Resolved through git's own
    # pathspec matching (a directory argument expands to its files, exactly
    # as the add did), so rule 11 compares like with like. Recorded as well
    # as the whole index — rule 5 needs the index, rule 11 needs the intent,
    # and they are different questions.
    mine_set() {
        j=1
        set --
        while [ $j -le $ARGC ]; do
            eval "a=\${ARGV_$j}"
            case "$a" in
                add|-*) ;;
                *) set -- "$@" "$a" ;;
            esac
            j=$((j + 1))
        done
        [ $# -gt 0 ] || return 0
        "$REAL_GIT" diff --cached --name-only -- "$@" 2>/dev/null | LC_ALL=C sort
    }

    tok="$(stage_token_path "$PPID")"
    mkdir -p "$(dirname "$tok")" 2>/dev/null || true
    (
        umask 077
        {
            printf 'repo=%s\n' "$(repo_ident)"
            printf -- '--mine--\n'
            mine_set
            printf -- '--\n'
            staged_set
        } > "$tok"
    ) 2>/dev/null || true
    exit 0
fi

# ─────────────────────────────────────────────────────────────────
# Rule 5: subcommand == commit
# ─────────────────────────────────────────────────────────────────
if [ "$SUBCMD" = "commit" ]; then
    # Detect whether this is the COMMIT half of an `add ... && commit`
    # one-liner (allowed) or a bare `git commit` (forbidden). Rule:
    # parent shell command must contain `git add ` BEFORE this commit.
    # Also reject `git commit -a` outright — that's the same foot-gun
    # as `add -A`.
    for a in "$@"; do
        case "$a" in
            -a|--all|-am|-am*|-a*m|-Am)
                deny "'git commit -a' is forbidden — it's 'git add -A' in disguise." \
                    "Why: -a auto-stages every modified tracked file, exactly the over-staging we banned. Stage by name:
   git add path/to/file1 path/to/file2 && git commit -m \"msg\"" "$@" ;;
            # Rule 10, second form. `-c user.email=` is caught during the
            # global-flag scan; --author is commit's own way to do it.
            --author|--author=*)
                BYPASS_VAR="GIT_UNSAFE_IDENTITY"
                deny "'git commit --author' rewrites the commit identity." \
                    "Why: it attributes the commit to someone other than this machine's configured author. See rule 10 — the same reasoning as '-c user.email='.

 Do this instead:
   git commit -m \"msg\"     # use the configured identity" "$@" ;;
        esac
    done

    # Rule 10, third form: the environment. git honours these over config, so
    # exporting one is `-c user.email=` by another route.
    #
    # Deliberately scoped to `commit`: filter-branch's --env-filter sets these
    # legitimately, but it drives `git commit-tree`, which this wrapper never
    # inspects. Blocking them globally would break history rewrites.
    if [ "${GIT_UNSAFE_IDENTITY:-}" != "1" ]; then
        for v in GIT_AUTHOR_EMAIL GIT_AUTHOR_NAME GIT_COMMITTER_EMAIL GIT_COMMITTER_NAME; do
            eval "vval=\${$v:-}"
            if [ -n "$vval" ]; then
                BYPASS_VAR="GIT_UNSAFE_IDENTITY"
                deny "$v is set — it overrides the configured commit identity." \
                    "Why: git prefers these environment variables over user.name / user.email, so exporting one rewrites authorship exactly like '-c user.email=' does. See rule 10.

 Currently set:
   $v=$vval

 Do this instead:
   unset $v && git commit -m \"msg\"" "$@"
            fi
        done
    fi

    # State check, not a text check. A stage token is written by rule 4
    # when `git add` runs; it records the repo and the exact staged set.
    # We require a fresh token from our own process ancestry, for THIS
    # repo, whose recorded set still matches the index.
    tok="$(find_stage_token 2>/dev/null || true)"

    if [ -z "$tok" ]; then
        deny "'git commit' must be preceded by 'git add <files>' in the same shell command." \
            "Why: a bare 'git commit' ships whatever was staged on a prior turn — possibly by another agent. Combine stage + commit:
   git add path/to/file1 path/to/file2 && git commit -m \"msg\"" "$@"
    fi

    tok_repo="$(sed -n 's/^repo=//p' "$tok" 2>/dev/null | head -1)"
    if [ "$tok_repo" != "$(repo_ident)" ]; then
        rm -f "$tok" 2>/dev/null || true
        deny "the pending 'git add' was for a different repository." \
            "Why: a stage token from another checkout must never authorise a commit here. Stage and commit in the same repo:
   git add path/to/file1 path/to/file2 && git commit -m \"msg\"" "$@"
    fi

    # Everything after the '--' marker is the staged set as it was
    # immediately after the add.
    tok_files="$(sed -n '/^--$/,$p' "$tok" 2>/dev/null | tail -n +2)"
    now_files="$(staged_set)"
    if [ "$tok_files" != "$now_files" ]; then
        deny "the staged file set changed between 'git add' and 'git commit'." \
            "Why: something modified the index after you staged — typically a parallel agent adding its own files, which your commit would then ship. This is exactly the race the atomic stage+commit rule exists to stop.

 Re-stage explicitly and commit in one command:
   git add path/to/file1 path/to/file2 && git commit -m \"msg\"

 Staged when you added:
$(printf '%s' "$tok_files" | sed 's/^/   /')

 Staged now:
$(printf '%s' "$now_files" | sed 's/^/   /')" "$@"
    fi

    # ── Rule 11: don't ship what you didn't stage ────────────────
    # Only for a commit with NO pathspec. `git commit <paths>` commits
    # those paths from the working tree and ignores the rest of the
    # index by construction, which is the documented repair for this
    # very situation.
    commit_has_pathspec=0
    seen_ddash=0
    skip_next=0
    for a in "$@"; do
        if [ "$skip_next" -eq 1 ]; then skip_next=0; continue; fi
        if [ "$seen_ddash" -eq 1 ]; then commit_has_pathspec=1; break; fi
        case "$a" in
            commit) ;;
            --) seen_ddash=1 ;;
            # Options that take a SEPARATE value — without this the value
            # ("msg") reads as a pathspec and rule 11 goes quiet.
            -m|-F|-c|-C|--message|--file|--reuse-message|--reedit-message|--author|--date|--cleanup|--gpg-sign|-S)
                skip_next=1 ;;
            -*) ;;
            *) commit_has_pathspec=1; break ;;
        esac
    done

    if [ "$commit_has_pathspec" -eq 0 ]; then
        tok_mine="$(sed -n '/^--mine--$/,/^--$/p' "$tok" 2>/dev/null \
            | sed '1d;$d')"
        # Anything staged that this shell's add did not name.
        theirs="$(printf '%s\n' "$now_files" \
            | LC_ALL=C comm -23 - <(printf '%s\n' "$tok_mine") 2>/dev/null \
            | sed '/^$/d')"
        if [ -n "$theirs" ]; then
            rm -f "$tok" 2>/dev/null || true
            deny "the index holds files your 'git add' did not name." \
                "Why: 'git commit' commits the whole INDEX, not the paths you staged — so another session's already-staged work rides along in your commit. Rules 4-5 only catch a stage that lands BETWEEN your add and your commit; this was staged before you arrived, and the index records no authorship. (Shipped 2026-08-23: fourteen files another session had staged went out inside an unrelated commit.)

 Not yours, currently staged:
$(printf '%s' "$theirs" | sed 's/^/   /')

 Commit only yours — a pathspec ignores the rest of the index:
   git add path/to/file1 path/to/file2 && git commit path/to/file1 path/to/file2 -m \"msg\"" "$@"
        fi
    fi

    # Single use — a token must never authorise a second commit.
    rm -f "$tok" 2>/dev/null || true
fi

# ─────────────────────────────────────────────────────────────────
# Rule 6: subcommand == reset
# ─────────────────────────────────────────────────────────────────
# `git reset --hard` discards uncommitted working-tree changes
# silently. When multiple Claude sessions or agents share a checkout
# (the normal case in this repo), one agent's "fast-forward to merged
# origin" can blow away another agent's in-flight WIP — exactly the
# pattern that wiped 300+ lines of manifest code on 2026-05-24 when
# a parallel agent ran `git reset --hard origin/staging/partition-done`
# after merging PR #85. Refuse `reset --hard` whenever the working
# tree (or index) has uncommitted changes; force the caller to deal
# with the WIP explicitly first.
if [ "$SUBCMD" = "reset" ]; then
    saw_hard=0
    for a in "$@"; do
        case "$a" in
            --hard) saw_hard=1 ;;
        esac
    done

    if [ "$saw_hard" = "1" ]; then
        # Check for any uncommitted change: staged, unstaged, OR
        # untracked. Untracked matters because `reset --hard <ref>`
        # itself doesn't delete untracked files, BUT a typical
        # "clean slate" sequence pairs it with `git clean -fd` which
        # does — so we surface the dirty state regardless and let
        # the caller make an informed choice.
        DIRTY="$("$REAL_GIT" status --porcelain 2>/dev/null || true)"
        if [ -n "$DIRTY" ]; then
            COUNT=$(printf '%s\n' "$DIRTY" | wc -l | tr -d ' ')
            FILES="$(printf '%s\n' "$DIRTY" | head -6 | sed 's/^/   /')"
            EXTRA=""
            if [ "$COUNT" -gt 6 ]; then
                EXTRA="$(printf '%s\n' "   ... and $((COUNT - 6)) more")"
            fi
            deny "'git reset --hard' with uncommitted changes in the working tree." \
                "Why: --hard silently throws away unstaged + staged work. If a parallel agent / sibling session is mid-edit on these files, you would erase their WIP without warning.

 Dirty files ($COUNT):
$FILES
$EXTRA

 Resolve first:
   1. If the WIP is yours:   stash ONLY your files by path — git stash push -- <your paths>
      (whole-tree 'git stash -u' is itself refused: it sweeps other sessions' WIP)
   2. Need a clean tree to work in? Use a worktree instead of resetting:
        git worktree add .claude/worktrees/<name> <ref>
   3. If you don't know whose WIP it is:   stop and ask the user — another session may be active." "$@"
        fi
    fi
fi

# ─────────────────────────────────────────────────────────────────
# Rule 8: subcommand == stash (whole-tree forms)
# ─────────────────────────────────────────────────────────────────
# A bare `git stash` (or `stash -u` / pathless `stash push`) sweeps up EVERY
# dirty file in the shared checkout — including a parallel session's WIP —
# and the later `pop` collides with whatever changed meanwhile (shipped
# 2026-07-26: an agent's stash/pop in the shared hayom checkout wiped its own
# edits and nearly a sibling's). Allowed without bypass:
#   git stash list / show                       (read-only)
#   git stash push [-m msg] -- <explicit paths> (stash only YOUR files)
#   git stash pop / apply / drop                (restores only what was pushed)
# Refused: bare `git stash`, `stash -u/-a/--include-untracked/--all`, and
# `stash push` with no pathspec. Need a clean HEAD to test against? Use a
# worktree: git worktree add .claude/worktrees/<name> HEAD
if [ "$SUBCMD" = "stash" ]; then
    STASH_OP=""
    HAS_PATHSPEC=0
    SEEN_DASHDASH=0
    j=1
    while [ $j -le $# ]; do
        eval "a=\${$j}"
        case "$a" in
            stash) ;;
            --) SEEN_DASHDASH=1 ;;
            -u|--include-untracked|-a|--all)
                deny "'git stash $a' sweeps untracked files across the SHARED checkout." \
                    "Why: it grabs every session's in-flight work, not just yours. Stash only your own files by explicit path:
   git stash push -m \"why\" -- path/to/your/file1 path/to/your/file2
 Or test against a clean HEAD in a worktree instead:
   git worktree add .claude/worktrees/clean-check HEAD" "$@" ;;
            -*) ;;
            *)
                if [ -z "$STASH_OP" ] && [ "$SEEN_DASHDASH" -eq 0 ]; then
                    STASH_OP="$a"
                else
                    HAS_PATHSPEC=1
                fi ;;
        esac
        j=$((j + 1))
    done
    case "${STASH_OP:-push}" in
        list|show|pop|apply|drop|branch) exec "$REAL_GIT" "$@" ;;
        push|save|"")
            if [ "$HAS_PATHSPEC" -eq 1 ]; then
                exec "$REAL_GIT" "$@"
            fi
            deny "whole-tree 'git stash' is forbidden — the checkout is SHARED." \
                "Why: a pathless stash sweeps EVERY dirty file, including parallel sessions' work-in-progress, and the later pop collides with whatever changed meanwhile (this shipped 2026-07-26 in the hayom checkout).

 Do one of these instead:
   1. Stash only YOUR files:  git stash push -m \"why\" -- <your paths>
   2. Need a pristine HEAD to compare against? Use a worktree:
        git worktree add .claude/worktrees/clean-check HEAD" "$@" ;;
        *) exec "$REAL_GIT" "$@" ;;
    esac
fi

# ─────────────────────────────────────────────────────────────────
# Rule 7: subcommand == checkout | switch (HEAD-moving forms)
# ─────────────────────────────────────────────────────────────────
# A checkout's branch is a SHARED resource: parallel Claude sessions,
# other agents, and the user all share one HEAD in a given working
# dir. One agent creating/switching a branch silently moves EVERYONE
# — their edits start landing on the wrong branch (shipped 2026-07-21:
# an agent minted four ship/* branches on the shared CRM checkout to
# imitate `npm run ship` while other agents were mid-work).
#
# Allowed without bypass:
#   git checkout -- <path>            (file restore — no HEAD move)
#   git checkout <ref> -- <path>      (file restore from a ref)
#   git restore ... / git worktree add (different subcommands — the
#                                       worktree is the sanctioned
#                                       isolation for branch work)
# Everything else under checkout/switch moves (or can move) HEAD and
# is refused. The bypass IS the explicit-permission mechanism: get the
# user's say-so, then prefix `GIT_UNSAFE_BRANCH=1`.
if [ "$SUBCMD" = "checkout" ] || [ "$SUBCMD" = "switch" ]; then
    # (GIT_UNSAFE_BRANCH=1 is handled by the scoped bypass block above.)
    if [ "$SUBCMD" = "checkout" ]; then
        # `--` marks the pathspec form — a file restore, not a HEAD move.
        for a in "$@"; do
            if [ "$a" = "--" ]; then
                exec "$REAL_GIT" "$@"
            fi
        done
    fi

    deny "'git $SUBCMD' moves the shared checkout's HEAD — forbidden without explicit user permission." \
        "Why: this working dir's branch is shared by parallel Claude sessions, other agents, and the user. Creating or switching branches here silently moves ALL of them — their edits land on your branch (this shipped 2026-07-21).

 Do one of these instead:
   1. Work on the branch the checkout is already on.
   2. Need isolation? Use a git worktree (allowed, isolated HEAD):
        git worktree add .claude/worktrees/<name> -b <branch>
   3. Restoring a FILE (not switching)?  git checkout -- <path>   or   git restore <path>
   4. The user explicitly approved a branch move? Use the logged bypass:
        GIT_UNSAFE_BRANCH=1 git $(printf '%q ' "$@" | sed 's/ $//')" "$@"
fi

# ─────────────────────────────────────────────────────────────────
# Rule 9: subcommand == worktree add (location must be in-repo)
# ─────────────────────────────────────────────────────────────────
#
# Only `add` places a directory; list/remove/prune/move/lock are fine.
# The path is the first non-flag operand after `add`; flags that take
# a value (-b/-B) consume the next argument, so skip it.
if [ "$SUBCMD" = "worktree" ]; then
    wt_action=""; wt_path=""; skip_next=0; seen_add=0
    for a in "$@"; do
        if [ "$skip_next" = "1" ]; then skip_next=0; continue; fi
        case "$a" in
            worktree) continue ;;
            -b|-B) skip_next=1; continue ;;
            --reason) skip_next=1; continue ;;
            -*) continue ;;
            *)
                if [ -z "$wt_action" ]; then wt_action="$a"; [ "$a" = "add" ] && seen_add=1; continue; fi
                if [ "$seen_add" = "1" ] && [ -z "$wt_path" ]; then wt_path="$a"; fi
                ;;
        esac
    done

    if [ "$wt_action" = "add" ] && [ -n "$wt_path" ]; then
        # Resolve against cwd so a relative path is comparable. Done
        # TEXTUALLY on purpose: the target does not exist yet, so any
        # filesystem-based normalisation (realpath, `cd`) collapses it to
        # garbage — an earlier version resolved `.claude/worktrees/ok` to
        # `/ok` and refused the one path it was meant to allow.
        case "$wt_path" in
            /*) abs_wt="$wt_path" ;;
            *)  abs_wt="$(pwd)/$wt_path" ;;
        esac
        # `..` can't be normalised without touching the disk, so refuse it
        # outright rather than prefix-matching a path that may escape.
        case "/$abs_wt/" in
            */../*)
                deny "'git worktree add' path contains '..' — use a plain path under .claude/worktrees/." \
                    "Why: '..' can escape the repo, and the target doesn't exist yet so it can't be safely normalised.

 Do this instead:
   git worktree add .claude/worktrees/<name> -b <branch>" "$@"
                ;;
        esac
        toplevel="$("$REAL_GIT" rev-parse --show-toplevel 2>/dev/null || true)"
        allowed="${toplevel:-/nonexistent}/.claude/worktrees"

        case "$abs_wt" in
            "$allowed"/*) ;;   # inside the sanctioned directory — allow
            *)
                deny "'git worktree add' outside .claude/worktrees/ — worktrees belong inside the repo they came from." \
                    "Why: a worktree beside the repo reads like a separate project, outlives its branch, and can be committed into the parent by accident (2026-07-29). In-repo, one gitignore rule hides it and cleanup is obvious.

 Resolved path: $abs_wt
 Required prefix: $allowed/

 Do this instead:
   git worktree add .claude/worktrees/<name> -b <branch>
   git worktree remove .claude/worktrees/<name>     # when done

 Genuinely need it elsewhere (e.g. a relative include path must match)?
   GIT_UNSAFE_BRANCH=1 git $(printf '%q ' "$@" | sed 's/ $//')" "$@"
                ;;
        esac
    fi
fi

# All checks passed — forward to the real git.
exec "$REAL_GIT" "$@"
